<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PalCalcPath Condition="'$(PalCalcPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\tools\palcalc</PalCalcPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalworldMcpServer\PalworldMcpServer.csproj" />
    <Reference Include="PalCalc.Model" HintPath="$(PalCalcPath)\PalCalc.Model.dll" Private="true" />
  </ItemGroup>
</Project>
